# Local job / media artifacts (large files — use the workspace dir, not the repo).
# Anchored to repo root so we don't accidentally ignore route folders like
# web/src/app/projects/[id]/clips/.
/tmp/
/uploads/
/media/
/clips/
/artifacts/

# Local workspace (videos, transcripts, cuts, sliced clips, SQLite db).
# Keep the directory itself tracked via .gitkeep.
backend/data/**
!backend/data/.gitkeep
