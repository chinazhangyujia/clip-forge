# Copy this file to backend/.env and fill in real values.

# Which cloud LLM handles prompt-driven clip cutting.
#   claude   — Anthropic Claude (US dev profile, default)
#   deepseek — DeepSeek (one of the China-prod-accessible options)
# CLIPFORGE_LLM_PROVIDER=claude

# Anthropic Claude — required when CLIPFORGE_LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=

# DeepSeek — required when CLIPFORGE_LLM_PROVIDER=deepseek.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: override the cutting model. If unset, the active provider picks:
#   claude   → claude-sonnet-4-6
#   deepseek → deepseek-v4-flash
# CLIPFORGE_CUTTING_MODEL=

# Optional: faster-whisper model size. tiny | base | small | medium | large-v3.
# First run downloads ~150MB (base) up to ~3GB (large-v3) from Hugging Face.
# CLIPFORGE_WHISPER_MODEL=base

# Optional: workspace root override (defaults to backend/data/).
# CLIPFORGE_WORKSPACE_DIR=
